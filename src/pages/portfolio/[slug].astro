---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';

export async function getStaticPaths() {
  const items = (await getCollection('portfolio')).filter((item) => !item.data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

interface Props {
  item: any;
}

const { item } = Astro.props as Props;
const { Content } = await render(item);
---

<Layout
  title={`${item.data.title} - Daniel Granger`}
  description={item.data.description}
  ogImageAlt={`${item.data.title} project image`}
>
  <article>
    <h1>{item.data.title}</h1>
    {item.data.tags && <p>Tags: {item.data.tags.join(', ')}</p>}
    <Content />
  </article>
</Layout>
