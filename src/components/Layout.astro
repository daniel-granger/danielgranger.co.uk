---
import '../assets/css/global.css';
import footer from '../data/footer.json';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** Absolute URL of a custom OG image. Defaults to the auto-generated card for this page. */
  ogImage?: string;
  ogImageAlt?: string;
  ogImageType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  noIndex?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage,
  ogImageAlt,
  ogImageType,
  ogImageWidth,
  ogImageHeight,
  noIndex = false,
} = Astro.props;

const canonicalUrl = Astro.url.href;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const siteUrlString = siteUrl.href.replace(/\/$/, '');
const logoUrl = new URL('/android-chrome-512x512.png', siteUrl).href;
const socialProfiles = (footer.social_links ?? [])
  .map((link) => link.url)
  .filter((url) => /^https?:\/\//.test(url));

// Derive the auto-generated OG image URL from the current page's pathname
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const ogSlug = rawPath === '/' ? 'index' : rawPath.slice(1);
const defaultOgImage = Astro.site ? new URL(`og/${ogSlug}.png`, Astro.site).href : undefined;
const resolvedOgImage = ogImage ?? defaultOgImage;
const resolvedOgImageAlt = ogImageAlt ?? description ?? title;
const imageExtension = ogImage?.toLowerCase().match(/\.(avif|gif|jpe?g|png|webp)(?:[?#]|$)/)?.[1];
const resolvedOgImageType =
  ogImageType ??
  (imageExtension
    ? `image/${imageExtension === 'jpg' ? 'jpeg' : imageExtension}`
    : ogImage
      ? undefined
      : 'image/png');
const resolvedOgImageWidth = ogImageWidth ?? (ogImage ? undefined : 1200);
const resolvedOgImageHeight = ogImageHeight ?? (ogImage ? undefined : 630);
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrlString}#website`,
      url: siteUrlString,
      name: 'Daniel Granger',
      description,
      publisher: { '@id': `${siteUrlString}#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrlString}#organization`,
      name: 'Daniel Granger',
      url: siteUrlString,
      logo: {
        '@type': 'ImageObject',
        url: logoUrl,
        width: 512,
        height: 512,
      },
      sameAs: socialProfiles,
    },
    {
      '@type': 'Person',
      '@id': `${siteUrlString}#person`,
      name: 'Daniel Granger',
      url: siteUrlString,
      image: logoUrl,
      sameAs: socialProfiles,
    },
  ],
}).replace(/</g, '\\u003c');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <script type="application/ld+json" set:html={jsonLd}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Google+Sans+Code:wght@400;500;700&family=Google+Sans+Mono:wght@400;500;700&display=swap"
    />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Daniel Granger" />
    {resolvedOgImage && (
      <>
        <meta property="og:image" content={resolvedOgImage} />
        {resolvedOgImageWidth && <meta property="og:image:width" content={String(resolvedOgImageWidth)} />}
        {resolvedOgImageHeight && <meta property="og:image:height" content={String(resolvedOgImageHeight)} />}
        {resolvedOgImageType && <meta property="og:image:type" content={resolvedOgImageType} />}
        <meta property="og:image:alt" content={resolvedOgImageAlt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {resolvedOgImage && (
      <>
        <meta name="twitter:image" content={resolvedOgImage} />
        <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
      </>
    )}
    <title>{title}</title>
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-j5oLSmmwJ-mLW43IfYzi6.js"></script>
    <script is:inline>
      window.plausible = window.plausible || function (...args) {
        (window.plausible.q = window.plausible.q || []).push(args);
      };
      window.plausible.init = window.plausible.init || function (options) {
        window.plausible.o = options || {};
      };
      window.plausible.init();
    </script>
  </head>
  <body>
    <Header />
    <main class="container-lg slot-container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
